# Скопируй в .env и впиши свой ключ.
# Ключ: https://developers.sber.ru/studio -> GigaChat API -> "Получить ключ"
# (Authorization key в формате base64).
GIGACHAT_AUTH_KEY=

# GIGACHAT_API_PERS — для физлиц, GIGACHAT_API_B2B — для юрлиц
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# 1 — проверять SSL-сертификат GigaChat (нужен корневой сертификат Минцифры)
GIGACHAT_VERIFY_SSL=0
